<!doctype html>
<html lang="uk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>{{ title or "Хоменко Андрій" }}</title>

{% set site_url = "https://khomenko-build.work" %}
{% set page_url = site_url + page.url %}

<link rel="canonical" href="{{ page_url }}">

<!-- SEO -->
<meta name="description" content="{{ description or "Розробка ПОБ та ПВР на будь-які об'єкти будівництва, реконструкції та ремонту." }}">
<meta name="keywords" content="{{ keywords or "будівництво, інженерія, інфраструктура, ПОБ, ПОС, проект організації будівництва" }}">
<meta name="author" content="{{ author or "Хоменко Андрій" }}">

{% if noindex %}
<meta name="robots" content="noindex, nofollow">
{% else %}
<meta name="robots" content="index, follow">
{% endif %}

<!-- Open Graph -->
<meta property="og:type" content="article">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ page_url }}">
<meta property="og:site_name" content="Khomenko Build">

{% if image %}
<meta property="og:image" content="{{ site_url }}{{ image }}">
{% else %}
<meta property="og:image" content="{{ site_url }}/assets/images/og-default.jpg">
{% endif %}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
{% if image %}
<meta name="twitter:image" content="{{ site_url }}{{ image }}">
{% endif %}

<!-- Breadcrumb structured data -->
<script type="application/ld+json">
{
 "@context": "https://schema.org",
 "@type": "BreadcrumbList",
 "itemListElement": [
  {
   "@type": "ListItem",
   "position": 1,
   "name": "Головна",
   "item": "https://khomenko-build.work"
  }
  {% if section %}
  ,
  {
   "@type": "ListItem",
   "position": 2,
   "name": "{{ section_title }}",
   "item": "https://khomenko-build.work/{{ section }}/"
  }
  {% endif %}
  {% if title %}
  ,
  {
   "@type": "ListItem",
   "position": 3,
   "name": "{{ title }}",
   "item": "{{ page_url }}"
  }
  {% endif %}
 ]
}
</script>

<link rel="stylesheet" href="/assets/css/style.css?v=1">

<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">

<script src="https://www.google.com/recaptcha/api.js?render=6LfiB4MsAAAAAAN_XAclo4Esl_4LvB6BCLzHvmbV"></script>

</head>

<body>

{% include "header.njk" %}

{% if hero %}
<section class="hero">
<div class="hero-overlay"></div>
<div class="hero-content">
<h1>{{ hero_title }}</h1>
<h3>{{ hero_subtitle }}</h3>
</div>
</section>
{% endif %}

{% include "breadcrumbs.njk" %}

<main>
{{ content | safe }}
</main>

{% include "footer.njk" %}

<script>
document.addEventListener("DOMContentLoaded", () => {

/* DROPDOWN */

const dd = document.getElementById("normDropdown");

if(dd){

const trigger = dd.querySelector(".dropdown-trigger");
const canHover = window.matchMedia("(hover:hover) and (pointer:fine)").matches;

function setExpanded(open){
dd.classList.toggle("open", open);
trigger.setAttribute("aria-expanded", String(open));
}

if(!canHover){

trigger.addEventListener("click", e=>{
e.preventDefault();
setExpanded(!dd.classList.contains("open"));
});

document.addEventListener("click", e=>{
if(!dd.contains(e.target)) setExpanded(false);
});

}else{

dd.addEventListener("mouseenter", ()=>setExpanded(true));
dd.addEventListener("mouseleave", ()=>setExpanded(false));

}
const tocToggle = document.querySelector(".toc-toggle");
const toc = document.getElementById("postToc");

if(tocToggle && toc){
  tocToggle.addEventListener("click",()=>{
    toc.classList.toggle("open");
  });
}
}

/* CONTACT FORM */

const forms = document.querySelectorAll(".contactForm");

if(forms.length){

forms.forEach(form=>{

const statusEl = form.querySelector(".formStatus") || {textContent:""};

form.addEventListener("submit", async e=>{

e.preventDefault();
statusEl.textContent="Надсилаю...";

try{

await new Promise(resolve=>grecaptcha.ready(resolve));

const token = await grecaptcha.execute(
"6LfiB4MsAAAAAAN_XAclo4Esl_4LvB6BCLzHvmbV",
{action:"contact"}
);

const data={
email:form.querySelector('[name="email"]').value.trim(),
text:form.querySelector('[name="text"]').value.trim(),
recaptcha:token
};

const res = await fetch("/api/contact",{
method:"POST",
headers:{"Content-Type":"application/json"},
body:JSON.stringify(data)
});

if(res.ok){
statusEl.textContent="Повідомлення надіслано!";
form.reset();
}else{
statusEl.textContent="Помилка при надсиланні.";
}

}catch(err){
console.error(err);
statusEl.textContent="Помилка мережі.";
}

});

});

}

/* IMAGE LIGHTBOX */

const lightbox = document.getElementById("blogLightbox");

if(lightbox){

const lightboxImg = lightbox.querySelector("img");

document.querySelectorAll("main img").forEach(img=>{

img.style.cursor="zoom-in";

img.addEventListener("click",()=>{
lightboxImg.src = img.src;
lightbox.classList.add("open");
});

});

lightbox.addEventListener("click",()=>{
lightbox.classList.remove("open");
});

}

/* TABLE OF CONTENTS */

const content = document.getElementById("postContent");
const tocList = document.getElementById("tocList");

if(content && tocList){

const headings = content.querySelectorAll("h2, h3");

headings.forEach((heading,i)=>{

const id = "section-"+i;
heading.id=id;

const li=document.createElement("li");
const a=document.createElement("a");

a.href="#"+id;
a.textContent=heading.textContent;

if(heading.tagName==="H3"){
a.style.marginLeft="12px";
}

li.appendChild(a);
tocList.appendChild(li);

});

const links = tocList.querySelectorAll("a");

window.addEventListener("scroll",()=>{

let current="";

headings.forEach(h=>{
const rect = h.getBoundingClientRect();
if(rect.top <= 120){
current = h.id;
}
});

links.forEach(link=>{
link.classList.remove("active");
if(link.getAttribute("href")==="#"+current){
link.classList.add("active");
}
});

});

}

/* TOC MOBILE */

const tocToggle = document.querySelector(".toc-toggle");
const toc = document.getElementById("postToc");

if(tocToggle && toc){
tocToggle.addEventListener("click",()=>{
toc.classList.toggle("open");
});
}

});
</script>

<div id="blogLightbox" class="blog-lightbox">
<img src="" alt="">
</div>

<!-- Floating contact button -->

<button id="contactFab" class="contact-fab" aria-label="Зв'язатися зі мною">
  <svg viewBox="0 0 24 24" fill="none">
    <path d="M7 4h3l1 5-2 2c1.4 2.8 3.7 5.1 6.5 6.5l2-2 5 1v3c0 .6-.4 1-1 1C11.8 21 3 12.2 3 5c0-.6.4-1 1-1h3z"
      stroke="currentColor"
      stroke-width="2"
      stroke-linejoin="round"/>
    <path d="M19 4v6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <path d="M16 7h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  </svg>
</button>

<!-- Contact modal -->

<div id="contactModal" class="contact-modal">

  <div class="contact-modal__backdrop"></div>

  <div class="contact-modal__window">

    <button class="contact-modal__close">&times;</button>

    <h3>Зв'язатися зі мною</h3>

    <form class="contactForm">

      <label>Email</label>
      <input type="email" name="email" required>

      <label>Повідомлення</label>
      <textarea name="text" required></textarea>

      <button type="submit">Надіслати</button>

      <p class="formStatus"></p>

    </form>

  </div>

</div>
</body>
</html>
