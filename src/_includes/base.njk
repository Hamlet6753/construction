<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{{ title or "Хоменко Андрій" }}</title>

  <link rel="canonical" href="https://khomenko-build.work{{ page.url | url }}">

  <link rel="stylesheet" href="/assets/css/style.css?v=1">

  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <!-- reCAPTCHA v3 -->
  <script src="https://www.google.com/recaptcha/api.js?render=6LfiB4MsAAAAAAN_XAclo4Esl_4LvB6BCLzHvmbV"></script>
</head>

<body>

  {% include "header.njk" %}

  {% if hero %}
  <section class="hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1>{{ hero_title }}</h1>
      <h3>{{ hero_subtitle }}</h3>
    </div>
  </section>
  {% endif %}

  <main>
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}

<script>
/* ===== DROPDOWN ===== */
document.addEventListener("DOMContentLoaded", () => {

  const dd = document.getElementById('normDropdown');
  if (dd) {
    const trigger = dd.querySelector('.dropdown-trigger');
    const menu = dd.querySelector('.dropdown-menu');
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    function setExpanded(isOpen) {
      dd.classList.toggle('open', isOpen);
      trigger.setAttribute('aria-expanded', String(isOpen));
    }

    if (!canHover) {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        setExpanded(!dd.classList.contains('open'));
      });

      document.addEventListener('click', (e) => {
        if (!dd.contains(e.target)) setExpanded(false);
      });

    } else {
      dd.addEventListener('mouseenter', () => setExpanded(true));
      dd.addEventListener('mouseleave', () => setExpanded(false));
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setExpanded(false);
    });
  }


  /* ===== CONTACT FORM ===== */
  const form = document.getElementById("contactForm");
  const statusEl = document.getElementById("formStatus");

  if (!form) return;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    statusEl.textContent = "Надсилаю...";

    try {

      await new Promise(resolve => grecaptcha.ready(resolve));

      const token = await grecaptcha.execute(
        "6LfiB4MsAAAAAAN_XAclo4Esl_4LvB6BCLzHvmbV",
        { action: "contact" }
      );

      const data = {
        email: form.email.value.trim(),
        text: form.text.value.trim(),
        recaptcha: token
      };

      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data)
      });

      if (res.ok) {
        statusEl.textContent = "Повідомлення надіслано!";
        form.reset();
      } else {
        statusEl.textContent = "Помилка при надсиланні.";
      }

    } catch (err) {
      statusEl.textContent = "Помилка мережі.";
    }

  });

});
</script>

</body>
</html>
