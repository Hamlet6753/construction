</script>
  <h3>3. Нормативний аналог</h3>

  <label>
    Оберіть нормативний аналог
    <select id="normativeAnalog" required>
      <option value="">Спочатку оберіть тип об'єкта</option>
    </select>
  </label>

  <div class="calc-analog-info" id="analogInfo">
    <p class="calc-muted">Після вибору аналога тут з'являться нормативні дані.</p>
  </div>
</div>

      <div class="calc-step">
        <h3>4. Умови будівництва</h3>

        <label class="calc-check">
          <input type="checkbox" id="denseDevelopment">
          Будівництво в умовах щільної забудови
        </label>

        <label class="calc-check">
          <input type="checkbox" id="utilitiesPresent">
          У зоні робіт є діючі інженерні мережі
        </label>

        <label class="calc-check">
          <input type="checkbox" id="limitedSite">
          Обмежений будівельний майданчик
        </label>

        <label class="calc-check">
          <input type="checkbox" id="activeFacility">
          Роботи виконуються на території діючого підприємства або установи
        </label>
      </div>

      <div class="calc-step">
        <h3>5. Підземна частина та геологія</h3>

        <label>
          Тип фундаментів
          <select id="foundationType">
            <option value="standard">Звичайні фундаменти</option>
            <option value="pile">Пальові фундаменти</option>
            <option value="slab">Плитний фундамент</option>
            <option value="deep">Заглиблена підземна частина</option>
          </select>
        </label>

        <label>
          Глибина фундаментів
          <select id="foundationDepth">
            <option value="normal">До 2 м</option>
            <option value="medium">2-4 м</option>
            <option value="deep">4-6 м</option>
            <option value="veryDeep">Більше 6 м</option>
          </select>
        </label>

        <label class="calc-check">
          <input type="checkbox" id="basement">
          Є підвал або підземна частина
        </label>

        <label class="calc-check">
          <input type="checkbox" id="undergroundParking">
          Є підземний паркінг
        </label>

        <label class="calc-check">
          <input type="checkbox" id="sheetPile">
          Потрібне шпунтове огородження котловану
        </label>

        <label class="calc-check">
          <input type="checkbox" id="dewatering">
          Потрібне водопониження або водовідлив
        </label>

        <label>
          Інженерно-геологічні умови
          <select id="geology">
            <option value="normal">Звичайні</option>
            <option value="complex">Складні</option>
            <option value="veryComplex">Особливо складні</option>
          </select>
        </label>
      </div>

      <div class="calc-step">
        <h3>6. Організація робіт</h3>

        <label>
          Режим роботи
          <select id="shifts">
            <option value="1">1 зміна</option>
            <option value="2">2 зміни</option>
            <option value="3">3 зміни</option>
          </select>
        </label>

        <label class="calc-check">
          <input type="checkbox" id="winterWorks">
          Основні роботи виконуються в зимовий період
        </label>
      </div>

      <button class="calc-submit" type="submit">Розрахувати тривалість</button>

    </form>

    <aside class="calc-result" id="calcResult">
      <h3>Результат</h3>

      <div class="calc-result-main">
        <span id="resultDuration">-</span>
        <small>місяців</small>
      </div>

      <div class="calc-result-list">
        <p><strong>Тс:</strong> <span id="resultBase">-</span></p>
        <p><strong>K1:</strong> <span id="resultK1">-</span></p>
        <p><strong>K2:</strong> <span id="resultK2">-</span></p>
        <p><strong>K3:</strong> <span id="resultK3">-</span></p>
        <p><strong>Коефіцієнт потужності:</strong> <span id="resultPower">-</span></p>
      </div>

      <p class="calc-note">
        Формула: Т = (Тс x K1 x K2) / K3
      </p>
    </aside>

  </div>
</section>
<script src="/assets/js/duration-data.js"></script>
<script>
document.addEventListener("DOMContentLoaded", () => {

  const subtypeMap = {
    residential: [
      { value: "apartment", label: "Багатоквартирний житловий будинок", capacity: "area", unit: "м2" },
      { value: "private_house", label: "Садибний житловий будинок", capacity: "area", unit: "м2" },
      { value: "dormitory", label: "Гуртожиток", capacity: "area", unit: "м2" }
    ],

    public: [
      { value: "office", label: "Офісна будівля", capacity: "area", unit: "м2" },
      { value: "trade", label: "Торговельна будівля", capacity: "area", unit: "м2" },
      { value: "school", label: "Школа / загальноосвітній заклад", capacity: "students", unit: "учнів" },
      { value: "cinema", label: "Кінотеатр", capacity: "seats", unit: "місць" },
      { value: "theatre", label: "Театр / концертний зал", capacity: "seats", unit: "місць" },
      { value: "clinic", label: "Поліклініка", capacity: "visits", unit: "відвідувань за зміну" },
      { value: "hospital", label: "Лікарня", capacity: "beds", unit: "ліжок" },
      { value: "pharmacy", label: "Аптека", capacity: "area", unit: "м2" },
      { value: "sport", label: "Спортивний корпус", capacity: "seats", unit: "умовна одиниця" },
      { value: "restaurant", label: "Ресторан / їдальня", capacity: "seats", unit: "місць" },
      { value: "bank", label: "Будівля банку", capacity: "area", unit: "м2" }
    ],

    hotel: [
      { value: "hotel", label: "Готель", capacity: "area", unit: "м2" },
      { value: "motel", label: "Мотель", capacity: "units", unit: "умовна одиниця" }
    ],

    network: [
      { value: "water_pipe", label: "Зовнішній водопровід", capacity: "length", unit: "км" },
      { value: "sewer_pipe", label: "Зовнішня каналізація", capacity: "length", unit: "км" },
      { value: "water_supply_structure", label: "Водозабірні споруди", capacity: "capacity", unit: "тис. м3/добу" },
      { value: "wastewater_treatment", label: "Очисні споруди водовідведення", capacity: "capacity", unit: "тис. м3/добу" },
      { value: "boiler", label: "Котельня / теплозабезпечення", capacity: "units", unit: "умовна одиниця" },
      { value: "power_cable", label: "Кабельна лінія електропередачі", capacity: "length", unit: "км" },
      { value: "gas_network", label: "Газова мережа", capacity: "length", unit: "км" },
      { value: "hdd", label: "Трубопровід методом ГНБ", capacity: "length", unit: "км" }
    ]
  };

  const capacityLabels = {
    area: "Фактична загальна площа",
    students: "Фактична кількість учнів",
    seats: "Фактична кількість місць",
    visits: "Фактична кількість відвідувань за зміну",
    beds: "Фактична кількість ліжок",
    volume: "Фактичний об'єм будівлі",
    length: "Фактична довжина",
    capacity: "Фактична потужність",
    capacity_per_day: "Фактична потужність",
    thermal_capacity: "Фактична теплова потужність",
    units: "Фактична умовна кількість"
  };

  const objectGroup = document.getElementById("objectGroup");
  const objectSubtype = document.getElementById("objectSubtype");
  const dynamicFields = document.getElementById("dynamicFields");
  const form = document.getElementById("durationCalcForm");
  const normativeAnalog = document.getElementById("normativeAnalog");
  const analogInfo = document.getElementById("analogInfo");
  const calcResult = document.getElementById("calcResult");

  function getStructureName(type) {
    const map = {
      wood: "дерев'яні",
      wooden: "дерев'яні",
      brick_panel: "кладочні вироби + панельне перекриття",
      brick_monolithic: "кладочні вироби + монолітне перекриття",
      precast_frame: "збірний каркас",
      frame_prefabricated: "збірний каркас",
      steel_sandwich: "металевий каркас + тришарові панелі",
      steel_frame: "металевий каркас",
      curtain_panels: "навісні панелі",
      frame_monolithic: "каркасно-монолітні",
      monolithic: "монолітні стінові",
      monolithic_wall: "монолітні стінові",
      panel: "панельні"
    };

    return map[type] || "";
  }

  function getExtraAnalogLabel(item) {
    const parts = [];
    const structureName = getStructureName(item.structureType);

    if (structureName && !item.label.toLowerCase().includes(structureName.toLowerCase())) {
      parts.push(structureName);
    }

    if (item.pipeMaterial) {
      const materialMap = {
        steel: "сталеві труби",
        polyethylene: "поліетиленові труби",
        cast_iron: "чавунні труби",
        reinforced_concrete: "залізобетонні труби"
      };
      parts.push(materialMap[item.pipeMaterial] || item.pipeMaterial);
    }

    if (item.pipeDiameter) {
      parts.push("DN" + item.pipeDiameter);
    }

    if (item.pullingForce) {
      parts.push("тягове зусилля " + item.pullingForce);
    }

    return parts.length ? " - " + parts.join(", ") : "";
  }

  function getAnalogLabel(item) {
    return item.label + getExtraAnalogLabel(item);
  }

  function resetResults() {
    document.getElementById("resultDuration").textContent = "-";
    document.getElementById("resultBase").textContent = "-";
    document.getElementById("resultK1").textContent = "-";
    document.getElementById("resultK2").textContent = "-";
    document.getElementById("resultK3").textContent = "-";
    document.getElementById("resultPower").textContent = "-";
  }

  function resetCalculatorUI() {
    form.reset();

    objectSubtype.innerHTML = '<option value="">Спочатку оберіть групу</option>';
    normativeAnalog.innerHTML = '<option value="">Спочатку оберіть тип об\'єкта</option>';

    dynamicFields.innerHTML =
      '<h3>2. Вихідні дані об\'єкта</h3><p class="calc-muted">Поля з\'являться після вибору типу об\'єкта.</p>';

    analogInfo.innerHTML =
      '<p class="calc-muted">Після вибору аналога тут з\'являться нормативні дані.</p>';

    resetResults();
  }

  resetCalculatorUI();

  window.addEventListener("pageshow", (event) => {
    if (event.persisted) {
      resetCalculatorUI();
    }
  });

  objectGroup.addEventListener("change", () => {
    const group = objectGroup.value;

    objectSubtype.innerHTML = '<option value="">Оберіть підтип</option>';
    normativeAnalog.innerHTML = '<option value="">Спочатку оберіть підтип</option>';
    analogInfo.innerHTML = '<p class="calc-muted">Після вибору аналога тут з\'являться нормативні дані.</p>';
    dynamicFields.innerHTML = '<h3>2. Вихідні дані об\'єкта</h3><p class="calc-muted">Оберіть підтип об\'єкта.</p>';
    resetResults();

    if (!group || !subtypeMap[group]) return;

    subtypeMap[group].forEach(item => {
      const option = document.createElement("option");
      option.value = item.value;
      option.textContent = item.label;
      option.dataset.capacity = item.capacity;
      option.dataset.unit = item.unit;
      objectSubtype.appendChild(option);
    });
  });

  objectSubtype.addEventListener("change", () => {
    const option = objectSubtype.options[objectSubtype.selectedIndex];
    const capacity = option.dataset.capacity;
    const unit = option.dataset.unit;

    normativeAnalog.innerHTML = '<option value="">Оберіть нормативний аналог</option>';
    analogInfo.innerHTML = '<p class="calc-muted">Після вибору аналога тут з\'являться нормативні дані.</p>';
    resetResults();

    if (!capacity) return;

    let html = `
      <h3>2. Вихідні дані об'єкта</h3>

      <label>
        ${capacityLabels[capacity]}, ${unit}
        <input id="actualCapacity" type="number" min="0" step="0.01" required autocomplete="off">
      </label>
    `;

    if (["area"].includes(capacity)) {
      html += `
        <label>
          Поверховість
          <input id="floors" type="number" min="1" step="1" autocomplete="off">
        </label>

        <label>
          Конструктивна схема
          <select id="structureType">
            <option value="">Не враховується автоматично</option>
            <option value="brick_panel">Кладочні вироби + панельне перекриття</option>
            <option value="brick_monolithic">Кладочні вироби + монолітне перекриття</option>
            <option value="panel">Панельна</option>
            <option value="monolithic">Монолітна стінова</option>
            <option value="frame_monolithic">Каркасно-монолітна</option>
            <option value="steel_sandwich">Металевий каркас + тришарові панелі</option>
          </select>
        </label>
      `;
    }

    if (
      objectGroup.value === "network" &&
      ["water_pipe", "sewer_pipe", "gas_network", "hdd"].includes(objectSubtype.value)
    ) {
      html += `
        <label>
          Матеріал труб
          <select id="pipeMaterial">
            <option value="">Не враховується автоматично</option>
            <option value="steel">Сталеві</option>
            <option value="polyethylene">Поліетиленові</option>
            <option value="cast_iron">Чавунні</option>
            <option value="reinforced_concrete">Залізобетонні</option>
          </select>
        </label>

        <label>
          Діаметр труб, мм
          <input id="pipeDiameter" type="number" min="0" step="1" autocomplete="off">
        </label>
      `;
    }

    dynamicFields.innerHTML = html;
    refreshNormativeAnalogs();
  });

  function refreshNormativeAnalogs() {
    const group = objectGroup.value;
    const subtype = objectSubtype.value;

    normativeAnalog.innerHTML = '<option value="">Оберіть нормативний аналог</option>';
    analogInfo.innerHTML = '<p class="calc-muted">Після вибору аналога тут з\'являться нормативні дані.</p>';

    if (!group || !subtype || !window.normativeDataset) return;

    const analogs = window.normativeDataset
      .filter(item => item.group === group && item.subtype === subtype)
      .sort((a, b) => {
        const ca = Number(a.normativeCapacity || 0);
        const cb = Number(b.normativeCapacity || 0);
        if (ca !== cb) return ca - cb;
        return getAnalogLabel(a).localeCompare(getAnalogLabel(b), "uk");
      });

    if (!analogs.length) {
      normativeAnalog.innerHTML = '<option value="">Для цього типу поки немає нормативних аналогів</option>';
      return;
    }

    analogs.forEach(item => {
      const option = document.createElement("option");
      option.value = item.id;
      option.textContent = getAnalogLabel(item);
      normativeAnalog.appendChild(option);
    });
  }

  normativeAnalog.addEventListener("change", () => {
    const analog = window.normativeDataset.find(
      item => item.id === normativeAnalog.value
    );

    resetResults();

    if (!analog) {
      analogInfo.innerHTML =
        '<p class="calc-muted">Після вибору аналога тут з\'являться нормативні дані.</p>';
      return;
    }

    const extraLabel = getExtraAnalogLabel(analog).replace(/^ - /, "");
    const extraLine = extraLabel ? `<p><strong>Конструкція / параметри:</strong> ${extraLabel}</p>` : "";

    analogInfo.innerHTML = `
      <p><strong>Нормативний показник:</strong> ${analog.normativeCapacity} ${analog.capacityUnit}</p>
      <p><strong>Нормативна тривалість:</strong> ${analog.normativeDurationTotal} міс.</p>
      ${extraLine}
      <p><strong>Джерело:</strong> ${analog.sourceTable}, ${analog.sourceNote}</p>
    `;
  });

  function getK1() {
    let k11 = 1;

    const geology = document.getElementById("geology").value;
    if (geology === "complex") k11 = 1.1;
    if (geology === "veryComplex") k11 = 1.3;

    let p1 = 0;
    if (document.getElementById("denseDevelopment").checked) p1 += 0.48;
    if (document.getElementById("limitedSite").checked) p1 += 0.06;
    if (p1 > 0.6) p1 = 0.6;

    const p2 = document.getElementById("utilitiesPresent").checked ? 0.15 : 0;
    const p3 = document.getElementById("activeFacility").checked ? 0.25 : 0;

    const k13 = 1 + p1 + p2 + p3;
    let k1 = k11 * k13;

    if (document.getElementById("winterWorks").checked) {
      k1 *= 1.05;
    }

    return k1;
  }

  function getK2() {
    let k = 1;

    const foundationType = document.getElementById("foundationType").value;
    const foundationDepth = document.getElementById("foundationDepth").value;

    if (foundationType === "pile") k += 0.05;
    if (foundationType === "deep") k += 0.10;
    if (foundationDepth === "medium") k += 0.05;
    if (foundationDepth === "deep") k += 0.10;
    if (foundationDepth === "veryDeep") k += 0.15;

    if (document.getElementById("basement").checked) k += 0.05;
    if (document.getElementById("undergroundParking").checked) k += 0.10;
    if (document.getElementById("sheetPile").checked) k += 0.05;
    if (document.getElementById("dewatering").checked) k += 0.05;

    return k;
  }

  function getK3() {
    const shifts = Number(document.getElementById("shifts").value);

    if (shifts === 2) return 1.1;
    if (shifts === 3) return 1.25;

    return 1;
  }

  form.addEventListener("submit", (e) => {
    e.preventDefault();

    const actualCapacity = Number(document.getElementById("actualCapacity")?.value || 0);
    const analog = window.normativeDataset.find(item => item.id === normativeAnalog.value);

    if (!analog) {
      alert("Оберіть нормативний аналог.");
      return;
    }

    const normativeCapacity = Number(analog.normativeCapacity || 0);
    const normativeDuration = Number(analog.normativeDurationTotal || 0);

    if (!actualCapacity || !normativeCapacity || !normativeDuration) {
      alert("Заповніть фактичний показник і оберіть нормативний аналог.");
      return;
    }

    const powerRatio = actualCapacity / normativeCapacity;
    const baseDuration = normativeDuration * powerRatio;

    const k1 = getK1();
    const k2 = getK2();
    const k3 = getK3();

    const finalDuration = (baseDuration * k1 * k2) / k3;

    document.getElementById("resultDuration").textContent = finalDuration.toFixed(1);
    document.getElementById("resultBase").textContent = baseDuration.toFixed(2) + " міс.";
    document.getElementById("resultK1").textContent = k1.toFixed(2);
    document.getElementById("resultK2").textContent = k2.toFixed(2);
    document.getElementById("resultK3").textContent = k3.toFixed(2);
    document.getElementById("resultPower").textContent = powerRatio.toFixed(3);

    calcResult.scrollIntoView({
      behavior: "smooth",
      block: "start"
    });
  });

});
</script>
